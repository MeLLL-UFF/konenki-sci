# ============================================================
#  MenopausIA — backend
#  Copie para .env e preencha. NUNCA commite o .env preenchido.
#  Em produção (Render), cadastre estas variáveis no painel,
#  não no arquivo.
# ============================================================

# ── Provider de LLM ──────────────────────────────────────────
# local = Ollama/vLLM na própria máquina | api = serviço em nuvem
LLM_PROVIDER=local
EMB_PROVIDER=api

# ── Ollama (quando LLM_PROVIDER=local) ───────────────────────
# Atenção: se o backend estiver hospedado, "localhost" é o container,
# não a sua máquina. Veja docs/ARQUITETURA.md.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── vLLM (fallback do provider local) ────────────────────────
# Deixe apontando para uma porta livre. O padrão 8000 colide com
# o próprio backend e mascara erros do Ollama.
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=mistral-7b-instruct

# ── Provider de API (quando LLM_PROVIDER=api) ────────────────
# Preencha apenas a chave do serviço que for usar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MARITACA_API_KEY=
LLM_API_MODEL=claude-sonnet-4-20250514

# ── Modelo por agente (opcional) ─────────────────────────────
# Vazio = usa o modelo padrão acima. Os nomes precisam ser válidos
# para o LLM_PROVIDER ativo: nome de modelo do Ollama se local,
# nome do serviço se api.
GUARDRAIL_MODEL=
RETRIEVAL_MODEL=
SIMPLIFIER_MODEL=

# ── PubMed ───────────────────────────────────────────────────
PUBMED_MAX_RESULTS=6

# ── NewsAPI (coleta de tendências) ───────────────────────────
NEWS_API_KEY=

# ── Banco (Supabase / PostgreSQL) ────────────────────────────
DB_HOST=seu-projeto.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# O Supabase exige SSL.
DB_SSLMODE=require

# ── Envio de email (Resend) ──────────────────────────────────
RESEND_API_KEY=
# Precisa ser um endereço válido, de domínio verificado no Resend.
# Sem domínio próprio, use onboarding@resend.dev — porém ele entrega
# APENAS para o email dono da conta Resend.
EMAIL_FROM="MenopausIA <onboarding@resend.dev>"

# ── Frontend ─────────────────────────────────────────────────
# URL pública do site, usada no botão do email da newsletter.
SITE_URL=https://konenki-sci.vercel.app
